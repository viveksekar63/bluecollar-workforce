# Razorpay credentials. Keep the secret server-side only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Employer job publishing fee in INR. Change this for your business pricing.
EMPLOYER_JOB_PUBLISH_FEE_INR=99

# Registration OTP SMS provider. Use "console" for local development.
OTP_SMS_PROVIDER=console

# MSG91 settings for real SMS OTP delivery.
# Set OTP_SMS_PROVIDER=msg91 when these values are configured.
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxx
MSG91_TEMPLATE_ID=xxxxxxxxxxxxxxxx
