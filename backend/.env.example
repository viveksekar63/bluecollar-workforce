# Razorpay credentials. Keep the secret server-side only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Razorpay Subscriptions webhook secret. Set the same secret in Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Number of recurring billing cycles created for an employer subscription.
# 1200 monthly cycles is effectively a long-lived recurring subscription.
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=1200

# Razorpay Plan IDs created in Test Mode.
RAZORPAY_PLAN_STARTER_ID=plan_xxxxxxxxxxxxx
RAZORPAY_PLAN_GROWTH_ID=plan_xxxxxxxxxxxxx
RAZORPAY_PLAN_BUSINESS_ID=plan_xxxxxxxxxxxxx

# Legacy per-job publishing fee. Kept only for backwards compatibility during migration.
EMPLOYER_JOB_PUBLISH_FEE_INR=99

# Registration OTP SMS provider. Use "console" for local development.
OTP_SMS_PROVIDER=console

# MSG91 settings for real SMS OTP delivery.
# Set OTP_SMS_PROVIDER=msg91 when these values are configured.
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxx
MSG91_TEMPLATE_ID=xxxxxxxxxxxxxxxx
