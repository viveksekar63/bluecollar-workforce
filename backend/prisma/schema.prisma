generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  phone           String         @unique
  email           String?        @unique
  passwordHash    String?
  firstName       String
  lastName        String?
  profilePhotoUrl String?
  status          UserStatus     @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  auditLogs       AuditLog[]
  employer        Employer?
  notifications   Notification[]
  otpRequests     OtpRequest[]
  refreshTokens   RefreshToken[]
  roles           UserRole[]
  worker          Worker?
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model OtpRequest {
  id         String    @id @default(uuid())
  userId     String?
  phone      String
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])
  @@index([phone])
}

model Worker {
  id                   String                @id @default(uuid())
  userId               String                @unique
  workerCode           String                @unique
  dateOfBirth          DateTime?
  gender               Gender?
  maritalStatus        MaritalStatus?
  bio                  String?
  experienceYears      Decimal?
  professionCategory   String?
  profession           String?
  profileCompletion    Int                   @default(0)
  verificationStatus   VerificationStatus    @default(PENDING)
  verificationScore    Int?
  availabilityStatus   AvailabilityStatus    @default(AVAILABLE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  attendance           Attendance[]
  complaints           Complaint[]           @relation("WorkerComplaints")
  documents            Document[]
  emergencyContacts    EmergencyContact[]
  employmentHistory    EmploymentHistory[]
  applications         JobApplication[]
  assignments          JobAssignment[]
  paymentAccounts      PaymentAccount[]
  paymentTransactions  PaymentTransaction[]
  verificationConsents VerificationConsent[]
  verificationRequests VerificationRequest[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses            WorkerAddress[]
  bankAccounts         WorkerBankAccount[]
  certifications       WorkerCertification[]
  education            WorkerEducation[]
  languages            WorkerLanguage[]
  ratingsReceived      WorkerRating[]        @relation("WorkerRatings")
  reviewsReceived      WorkerReview[]        @relation("WorkerReviews")
  skills               WorkerSkill[]
  workPreferences      WorkerWorkPreference?
  preferredWorkLocations WorkerPreferredLocation[]
  @@index([professionCategory])
  @@index([profession])
}

model WorkerAddress {
  id           String      @id @default(uuid())
  workerId     String
  type         AddressType
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  state        String
  pincode      String
  latitude     Decimal?
  longitude    Decimal?
  isCurrent    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  worker       Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model WorkerWorkPreference {
  id                String   @id @default(uuid())
  workerId          String   @unique
  mobility           String   @default("LOCAL")
  willingToRelocate Boolean  @default(false)
  willingToTravel   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  worker            Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([mobility])
  @@map("worker_work_preferences")
}

model WorkerPreferredLocation {
  id        String   @id @default(uuid())
  workerId  String
  city      String
  district  String?
  state     String
  country   String   @default("India")
  createdAt DateTime @default(now())
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@unique([workerId, city, state])
  @@index([workerId])
  @@index([city, state])
  @@map("worker_preferred_locations")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  workerId     String
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model WorkerBankAccount {
  id            String   @id @default(uuid())
  workerId      String
  accountName   String
  accountNumber String
  ifscCode      String
  bankName      String
  isPrimary     Boolean  @default(false)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model Skill {
  id        String        @id @default(uuid())
  name      String        @unique
  category  String?
  createdAt DateTime      @default(now())
  jobs      JobSkill[]
  workers   WorkerSkill[]
}

model WorkerSkill {
  workerId        String
  skillId         String
  experienceYears Decimal?
  skillLevel      SkillLevel @default(BEGINNER)
  verified        Boolean    @default(false)
  skill           Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  worker          Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@id([workerId, skillId])
  @@index([skillId])
}

model Language {
  id      String           @id @default(uuid())
  name    String           @unique
  workers WorkerLanguage[]
}

model WorkerLanguage {
  workerId    String
  languageId  String
  proficiency LanguageLevel @default(BASIC)
  language    Language      @relation(fields: [languageId], references: [id], onDelete: Cascade)
  worker      Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@id([workerId, languageId])
  @@index([languageId])
}

model WorkerEducation {
  id            String   @id @default(uuid())
  workerId      String
  qualification String
  institution   String?
  fieldOfStudy  String?
  startYear     Int?
  endYear       Int?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model WorkerCertification {
  id            String    @id @default(uuid())
  workerId      String
  name          String
  issuingBody   String?
  certificateNo String?
  issuedDate    DateTime?
  expiryDate    DateTime?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  worker        Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model Employer {
  id             String         @id @default(uuid())
  userId         String         @unique
  companyName    String
  companyType    String?
  registrationNo String?
  gstNumber      String?
  description    String?
  status         EmployerStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  complaints     Complaint[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs           Job[]
  ratings        WorkerRating[]
  reviews        WorkerReview[]
}

model EmploymentHistory {
  id                 String                @id @default(uuid())
  workerId           String
  companyName        String
  companyAddress     String?
  designation        String
  startDate          DateTime
  endDate            DateTime?
  salary             Decimal?
  employmentType     EmploymentType?
  supervisorName     String?
  supervisorPhone    String?
  supervisorEmail    String?
  reasonForLeaving   String?
  verificationStatus VerificationStatus    @default(PENDING)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  documents          EmploymentDocument[]
  worker             Worker                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  references         EmploymentReference[]
  @@index([workerId])
}

model EmploymentReference {
  id                 String             @id @default(uuid())
  employmentId       String
  name               String
  designation        String?
  phone              String?
  email              String?
  relationship       String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  employment         EmploymentHistory  @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  @@index([employmentId])
}

model Document {
  id                  String                @id @default(uuid())
  workerId            String
  type                DocumentType
  fileName            String
  storageKey          String
  mimeType            String
  fileSize            Int
  documentNumber      String?
  verificationStatus  VerificationStatus    @default(PENDING)
  uploadedAt          DateTime              @default(now())
  verifiedAt          DateTime?
  worker              Worker                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  verification        DocumentVerification?
  employmentDocuments EmploymentDocument?
  @@index([workerId])
  @@index([type])
  @@index([verificationStatus])
}

model EmploymentDocument {
  id           String            @id @default(uuid())
  employmentId String
  documentId   String            @unique
  document     Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employment   EmploymentHistory @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  @@index([employmentId])
}

model DocumentVerification {
  id          String             @id @default(uuid())
  documentId  String             @unique
  provider    String?
  providerRef String?
  status      VerificationStatus
  remarks     String?
  verifiedAt  DateTime?
  document    Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id           String              @id @default(uuid())
  workerId     String
  status       VerificationStatus  @default(PENDING)
  overallScore Int?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  checks       VerificationCheck[]
  worker       Worker              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
  @@index([status])
}

model VerificationCheck {
  id                String              @id @default(uuid())
  verificationId    String
  type              VerificationType
  status             VerificationStatus  @default(PENDING)
  provider          String?
  providerReference String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  verification      VerificationRequest @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  result            VerificationResult?
  @@index([verificationId])
  @@index([type])
  @@index([status])
}

model VerificationResult {
  id                  String                   @id @default(uuid())
  verificationCheckId String                   @unique
  result              VerificationResultStatus
  score               Int?
  remarks             String?
  evidenceStorageKey  String?
  rawResponse         Json?
  createdAt            DateTime                 @default(now())
  verificationCheck   VerificationCheck        @relation(fields: [verificationCheckId], references: [id], onDelete: Cascade)
}

model VerificationConsent {
  id          String      @id @default(uuid())
  workerId    String
  consentType ConsentType
  consented   Boolean
  version     String
  ipAddress   String?
  userAgent   String?
  consentedAt DateTime    @default(now())
  worker      Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
  @@index([consentType])
}

model Job {
  id           String           @id @default(uuid())
  employerId   String
  title        String
  description  String
  city         String
  district     String?
  state        String
  pincode      String?
  latitude     Decimal?
  longitude    Decimal?
  salaryMin    Decimal?
  salaryMax    Decimal?
  salaryType   SalaryType
  openings     Int              @default(1)
  startDate    DateTime?
  endDate      DateTime?
  status       JobStatus        @default(DRAFT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  employer     Employer         @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  assignments  JobAssignment[]
  skills       JobSkill[]
  @@index([employerId])
  @@index([city])
  @@index([state])
  @@index([status])
}

model JobSkill {
  jobId    String
  skillId  String
  required Boolean @default(true)
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill    Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([jobId, skillId])
  @@index([skillId])
}

model JobApplication {
  id            String            @id @default(uuid())
  jobId         String
  workerId      String
  status        ApplicationStatus @default(APPLIED)
  appliedAt     DateTime          @default(now())
  shortlistedAt DateTime?
  rejectedAt    DateTime?
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker        Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@unique([jobId, workerId])
  @@index([workerId])
  @@index([jobId])
  @@index([status])
}

model JobAssignment {
  id         String           @id @default(uuid())
  jobId      String
  workerId   String
  startDate  DateTime
  endDate    DateTime?
  agreedRate Decimal
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  attendance Attendance[]
  job        Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker     Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
  @@index([jobId])
  @@index([status])
}

model Attendance {
  id           String            @id @default(uuid())
  assignmentId String
  workerId     String
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  latitudeIn   Decimal?
  longitudeIn  Decimal?
  latitudeOut  Decimal?
  longitudeOut Decimal?
  status       AttendanceStatus  @default(PRESENT)
  assignment   JobAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  worker       Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  breaks       AttendanceBreak[]
  @@unique([assignmentId, workerId, date])
  @@index([workerId, date])
  @@index([assignmentId, date])
}

model AttendanceBreak {
  id           String     @id @default(uuid())
  attendanceId String
  startTime    DateTime
  endTime      DateTime?
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  @@index([attendanceId])
}

model WorkerRating {
  id         String   @id @default(uuid())
  workerId   String
  employerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  worker     Worker   @relation("WorkerRatings", fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
  @@index([employerId])
}

model WorkerReview {
  id         String   @id @default(uuid())
  workerId   String
  employerId String
  title      String?
  comment    String
  createdAt  DateTime @default(now())
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  worker     Worker   @relation("WorkerReviews", fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
  @@index([employerId])
}

model PaymentAccount {
  id                String               @id @default(uuid())
  workerId          String
  provider          String?
  providerAccountId String?
  status            PaymentAccountStatus @default(PENDING)
  createdAt         DateTime             @default(now())
  worker            Worker               @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model PaymentTransaction {
  id        String        @id @default(uuid())
  workerId  String
  amount    Decimal
  currency  String        @default("INR")
  type      PaymentType
  status    PaymentStatus
  reference String?
  metadata  Json?
  createdAt DateTime      @default(now())
  worker    Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
  @@index([status])
  @@index([type])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
  @@index([type])
}

model Complaint {
  id          String          @id @default(uuid())
  workerId    String?
  employerId  String?
  type        ComplaintType
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime        @default(now())
  resolvedAt  DateTime?
  employer    Employer?       @relation(fields: [employerId], references: [id])
  worker      Worker?         @relation("WorkerComplaints", fields: [workerId], references: [id])
  @@index([workerId])
  @@index([employerId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  VERIFICATION_AGENT
  EMPLOYER
  SUPERVISOR
  WORKER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  OTHER
}

enum AddressType {
  CURRENT
  PERMANENT
}

enum AvailabilityStatus {
  AVAILABLE
  WORKING
  NOT_AVAILABLE
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  FAILED
  MANUAL_REVIEW
  EXPIRED
}

enum VerificationType {
  IDENTITY
  ADDRESS
  DOCUMENT
  EMPLOYMENT
  REFERENCE
  EDUCATION
  CRIMINAL
  SKILL
}

enum VerificationResultStatus {
  MATCH
  PARTIAL_MATCH
  NO_MATCH
  NOT_FOUND
  MANUAL_REVIEW
}

enum ConsentType {
  IDENTITY_CHECK
  ADDRESS_CHECK
  EMPLOYMENT_CHECK
  REFERENCE_CHECK
  BACKGROUND_CHECK
  DOCUMENT_STORAGE
  PROFILE_SHARING
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageLevel {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  DAILY_WAGE
  TEMPORARY
  SELF_EMPLOYED
}

enum DocumentType {
  PROFILE_PHOTO
  ID_PROOF
  ADDRESS_PROOF
  EXPERIENCE_LETTER
  SALARY_SLIP
  EDUCATION_CERTIFICATE
  SKILL_CERTIFICATE
  BANK_DOCUMENT
  OTHER
}

enum EmployerStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum SalaryType {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  CONTRACT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum PaymentAccountStatus {
  PENDING
  VERIFIED
  BLOCKED
}

enum PaymentType {
  SALARY
  DAILY_WAGE
  BONUS
  REFUND
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  JOB
  APPLICATION
  VERIFICATION
  PAYMENT
  SYSTEM
}

enum ComplaintType {
  WORKER
  EMPLOYER
  PAYMENT
  SAFETY
  FRAUD
  OTHER
}

enum ComplaintStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  REJECTED
}
