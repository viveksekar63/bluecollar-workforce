generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  phone           String         @unique
  email           String?        @unique
  passwordHash    String?
  firstName       String
  lastName        String?
  profilePhotoUrl String?
  status          UserStatus     @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  auditLogs       AuditLog[]
  employer        Employer?
  notifications   Notification[]
  otpRequests     OtpRequest[]
  refreshTokens   RefreshToken[]
  roles           UserRole[]
  worker          Worker?
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model OtpRequest {
  id         String    @id @default(uuid())
  userId     String?
  phone      String
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])
  @@index([phone])
}

model Worker {
  id                   String                @id @default(uuid())
  userId               String                @unique
  workerCode           String                @unique
  dateOfBirth          DateTime?
  gender               Gender?
  maritalStatus        MaritalStatus?
  bio                  String?
  experienceYears      Decimal?
  professionCategory   String?
  profession           String?
  profileCompletion    Int                   @default(0)
  verificationStatus   VerificationStatus    @default(PENDING)
  verificationScore    Int?
  availabilityStatus   AvailabilityStatus    @default(AVAILABLE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  attendance           Attendance[]
  complaints           Complaint[]           @relation("WorkerComplaints")
  documents            Document[]
  emergencyContacts    EmergencyContact[]
  employmentHistory    EmploymentHistory[]
  applications         JobApplication[]
  assignments          JobAssignment[]
  paymentAccounts      PaymentAccount[]
  paymentTransactions  PaymentTransaction[]
  verificationConsents VerificationConsent[]
  verificationRequests VerificationRequest[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses            WorkerAddress[]
  bankAccounts         WorkerBankAccount[]
  certifications       WorkerCertification[]
  education            WorkerEducation[]
  languages            WorkerLanguage[]
  ratingsReceived      WorkerRating[]        @relation("WorkerRatings")
  reviewsReceived      WorkerReview[]        @relation("WorkerReviews")
  skills               WorkerSkill[]
  @@index([professionCategory])
  @@index([profession])
}

model WorkerAddress {
  id           String      @id @default(uuid())
  workerId     String
  type         AddressType
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  state        String
  pincode      String
  latitude     Decimal?
  longitude    Decimal?
  isCurrent    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  worker       Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model EmergencyContact {
  id           String   @id @default(uuid())
  workerId     String
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model WorkerBankAccount {
  id            String   @id @default(uuid())
  workerId      String
  accountName   String
  accountNumber String
  ifscCode      String
  bankName      String
  isPrimary     Boolean  @default(false)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model Skill {
  id        String        @id @default(uuid())
  name      String        @unique
  category  String?
  createdAt DateTime      @default(now())
  jobs      JobSkill[]
  workers   WorkerSkill[]
}

model WorkerSkill {
  workerId        String
  skillId         String
  experienceYears Decimal?
  skillLevel      SkillLevel @default(BEGINNER)
  verified        Boolean    @default(false)
  skill           Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  worker          Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@id([workerId, skillId])
  @@index([skillId])
}

model Language {
  id      String           @id @default(uuid())
  name    String           @unique
  workers WorkerLanguage[]
}

model WorkerLanguage {
  workerId    String
  languageId  String
  proficiency LanguageLevel @default(BASIC)
  language    Language      @relation(fields: [languageId], references: [id], onDelete: Cascade)
  worker      Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@id([workerId, languageId])
  @@index([languageId])
}

model WorkerEducation {
  id            String   @id @default(uuid())
  workerId      String
  qualification String
  institution   String?
  fieldOfStudy  String?
  startYear     Int?
  endYear       Int?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model WorkerCertification {
  id            String    @id @default(uuid())
  workerId      String
  name          String
  issuingBody   String?
  certificateNo String?
  issuedDate    DateTime?
  expiryDate    DateTime?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  worker        Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
}

model Employer {
  id             String         @id @default(uuid())
  userId         String         @unique
  companyName    String
  companyType    String?
  registrationNo String?
  gstNumber      String?
  description    String?
  status         EmployerStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  complaints     Complaint[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs           Job[]
  ratings        WorkerRating[]
  reviews        WorkerReview[]
}

model EmploymentHistory {
  id                 String                @id @default(uuid())
  workerId           String
  companyName        String
  companyAddress     String?
  designation        String
  startDate          DateTime
  endDate            DateTime?
  salary             Decimal?
  employmentType     EmploymentType?
  supervisorName     String?
  supervisorPhone    String?
  supervisorEmail    String?
  reasonForLeaving   String?
  verificationStatus VerificationStatus    @default(PENDING)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  documents          EmploymentDocument[]
  worker             Worker                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  references         EmploymentReference[]
  @@index([workerId])
}

model EmploymentReference {
  id                 String             @id @default(uuid())
  employmentId       String
  name               String
  designation        String?
  phone              String?
  email              String?
  relationship       String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  employment         EmploymentHistory  @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  @@index([employmentId])
}

model Document {
  id                  String                @id @default(uuid())
  workerId            String
  type                DocumentType
  fileName            String
  storageKey          String
  mimeType            String
  fileSize            Int
  documentNumber      String?
  verificationStatus  VerificationStatus    @default(PENDING)
  uploadedAt          DateTime              @default(now())
  verifiedAt          DateTime?
  worker              Worker                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  verification        DocumentVerification?
  employmentDocuments EmploymentDocument?
  @@index([workerId])
  @@index([type])
  @@index([verificationStatus])
}

model EmploymentDocument {
  id           String            @id @default(uuid())
  employmentId String
  documentId   String            @unique
  document     Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employment   EmploymentHistory @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  @@index([employmentId])
}

model DocumentVerification {
  id          String             @id @default(uuid())
  documentId  String             @unique
  provider    String?
  providerRef String?
  status      VerificationStatus
  remarks     String?
  verifiedAt  DateTime?
  document    Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id           String              @id @default(uuid())
  workerId     String
  status       VerificationStatus  @default(PENDING)
  overallScore Int?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  checks       VerificationCheck[]
  worker       Worker              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
  @@index([status])
}

model VerificationCheck {
  id                String              @id @default(uuid())
  verificationId    String
  type              VerificationType
  status            VerificationStatus  @default(PENDING)
  provider          String?
  providerReference String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  verification      VerificationRequest @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  result            VerificationResult?
  @@index([verificationId])
  @@index([type])
  @@index([status])
}

model VerificationResult {
  id                  String                   @id @default(uuid())
  verificationCheckId String                   @unique
  result              VerificationResultStatus
  score               Int?
  remarks             String?
  evidenceStorageKey  String?
  rawResponse         Json?
  createdAt           DateTime                 @default(now())
  verificationCheck   VerificationCheck        @relation(fields: [verificationCheckId], references: [id], onDelete: Cascade)
}

model VerificationConsent {
  id          String      @id @default(uuid())
  workerId    String
  consentType ConsentType
  consented   Boolean
  version     String
  ipAddress   String?
  userAgent   String?
  consentedAt DateTime    @default(now())
  worker      Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
  @@index([consentType])
}

model Job {
  id           String           @id @default(uuid())
  employerId   String
  title        String
  description  String
  city         String
  district     String?
  state        String
  pincode      String?
  latitude     Decimal?
  longitude    Decimal?
  salaryMin    Decimal?
  salaryMax    Decimal?
  salaryType   SalaryType
  openings     Int              @default(1)
  startDate    DateTime?
  endDate      DateTime?
  status       JobStatus        @default(DRAFT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  employer     Employer         @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  assignments  JobAssignment[]
  skills       JobSkill[]
  @@index([employerId])
  @@index([city])
  @@index([state])
  @@index([status])
}

model JobSkill {
  jobId    String
  skillId  String
  required Boolean @default(true)
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill    Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([jobId, skillId])
  @@index([skillId])
}

model JobApplication {
  id            String            @id @default(uuid())
  jobId         String
  workerId      String
  status        ApplicationStatus @default(APPLIED)
  appliedAt     DateTime          @default(now())
  shortlistedAt DateTime?
  rejectedAt    DateTime?
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker        Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@unique([jobId, workerId])
  @@index([workerId])
  @@index([jobId])
  @@index([status])
}

model JobAssignment {
  id         String           @id @default(uuid())
  jobId      String
  workerId   String
  startDate  DateTime
  endDate    DateTime?
  agreedRate Decimal
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  attendance Attendance[]
  job        Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker     Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId])
  @@index([jobId])
  @@index([status])
}

model Attendance {
  id           String            @id @default(uuid())
  assignmentId String
  workerId     String
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  latitudeIn   Decimal?
  longitudeIn  Decimal?
  latitudeOut  Decimal?
  longitudeOut Decimal?
  status       AttendanceStatus  @default(PRESENT)
  assignment   JobAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  worker       Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  breaks       AttendanceBreak[]
